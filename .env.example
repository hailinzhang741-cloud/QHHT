TUSHARE_TOKEN=your_tushare_token_here

# 预测模型版本：4 或 5（修复未来函数后 v5 做多信号准确率约 67%，n≈21/5年）
# 小仓位实盘建议用 5：python run_calibration_v5.py --compare 后启用
MODEL_VERSION=5

# 每日都推微信（1=是，云端 GitHub Actions 建议设为 1）
DAILY_NOTIFY=0

# 推送（可选，三选一或组合）
# PushPlus 微信: https://www.pushplus.plus/
# 两个微信号: PUSHPLUS_TOKEN=token1,token2  （两人各注册 PushPlus）
# 或主号推好友: PUSHPLUS_TOKEN=主token  PUSHPLUS_TO=好友令牌1,好友令牌2
PUSHPLUS_TOKEN=
PUSHPLUS_TO=

# Server酱: https://sct.ftqq.com/
SERVERCHAN_KEY=

# 邮件 SMTP（QQ邮箱示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code
NOTIFY_EMAIL=your_email@qq.com
